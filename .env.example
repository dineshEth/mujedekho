# Copy to .env and fill in. NEVER commit real credentials.

# --- Runtime ---
APP_ENV=development
HTTP_ADDR=:8080
REGION=default

# --- Database (required) ---
# Local dev compose creates this user/database.
DATABASE_URL=postgres://site24x7:site24x7@localhost:5432/site24x7?sslmode=disable
# Used by `make test-integration` when pointing at a test database:
# TEST_DATABASE_URL=postgres://site24x7:site24x7@localhost:5432/site24x7_test?sslmode=disable

# --- Redis (optional; graceful fallback when unset) ---
REDIS_ADDR=localhost:6379

# --- Auth (JWT_SECRET REQUIRED outside development; use 32+ random bytes) ---
JWT_SECRET=
# ACCESS_TTL=15m
# REFRESH_TTL=720h

# --- Monitoring engine ---
WORKER_CONCURRENCY=8
SCHEDULER_TICK_MS=1000
CHECK_RETENTION_DAYS=30
# Optional: pin outgoing DNS for checks (comma-separated IP list)
# DNS_RESOLVERS=9.9.9.9,149.112.112.112

# --- Seeding (seed command only; never production) ---
SEED_EMAIL=demo@example.com
SEED_PASSWORD=

# --- Frontend (web/) — Next.js BFF proxy target ---
#API_BASE_URL=http://localhost:8080
